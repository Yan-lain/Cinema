.env
.env.local
.env.*.local

# 证书和密钥
*.pem
*.key
*.crt
*.pfx
*.p12
*.jks
*.keystore

# SSH密钥
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub

# 其他敏感文件
*.md5
*.sha1
*.sha256

# ==========================================
# Docker相关文件
# ==========================================
# Docker构建缓存
.dockerignore
docker-compose.override.yml

# ==========================================
# 文档和生成文件
# ==========================================
# 文档生成输出
site/
docs/_build/
docs/.vitepress/cache/

# PDF生成文件
*.pdf

# ==========================================
# IDE运行配置
# ==========================================
